# Copy this file to .env and fill in your own values. Never commit .env!

# ---- Server ----
PORT=3000

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db

# For cloud databases (e.g. TiDB Cloud): set DB_SSL=true.
# Only if your provider gives you a ca.pem file, paste its contents in DB_SSL_CA.
# Leave both empty for local MySQL.
DB_SSL=
DB_SSL_CA=

# ---- Gmail SMTP (Nodemailer) ----
# SMTP_PASS must be a 16-character Gmail "App Password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM_NAME=Portfolio

# Where contact form notifications are delivered
CONTACT_RECEIVER=your_email@gmail.com
